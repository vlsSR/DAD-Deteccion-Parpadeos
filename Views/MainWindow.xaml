<Window x:Class="ProyectoLectorParpadeos.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProyectoLectorParpadeos"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        Title="Sistema por parpadeo" Height="560" Width="680"
        MinWidth="520" MinHeight="640"
        Background="#121212" Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        
        <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*" MinWidth="350"/>
            <ColumnDefinition Width="1*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo (Contenedor general para estadísticas y video) -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--Panel izquierdo(informacion, arriba de video)-->
            <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}">
                <StackPanel>
                    <TextBlock Text="ESTADÍSTICAS" Style="{StaticResource CardHeaderStyle}"/>
                    <StackPanel Margin="0,2,0,2">
                        <TextBlock Text="{Binding TotalParpadeos, StringFormat=Parpadeos: {0}}" FontWeight="Bold" FontSize="15" Margin="0,0,0,6" Foreground="#FFFFFF"/>
                        <TextBlock Foreground="#4CD964" FontSize="15" Margin="0,0,0,6">
                            <Run Text="Tiempo abiertos: "/>
                            <Run Text="{Binding TiempoOjosAbiertos, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="#5AC8FA" FontSize="15" Margin="0,0,0,0">
                            <Run Text="Tiempo cerrados: "/>
                            <Run Text="{Binding TiempoOjosCerrados, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--Panel izquierdo(video)-->
            <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CÁMARA" Style="{StaticResource CardHeaderStyle}"/>

                    <!-- Contenedor del video adaptativo -->
                    <Border Grid.Row="1" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Background="#0A0A0A" MinHeight="160">
                        <Image Source="{Binding ImagenVideo}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!--Botones-->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="Iniciar" Command="{Binding IniciarCamaraCommand}" Width="105" Height="32" Margin="5" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="Detener" Command="{Binding DetenerCamaraCommand}" Width="105" Height="32" Margin="5" Background="#2D2D2D" Foreground="#E0E0E0" BorderThickness="1" BorderBrush="#3D3D3D" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Panel derecho arriba: Ultima petición por voz -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}">
                <StackPanel>
                    <TextBlock Text="Última petición por voz" Style="{StaticResource CardHeaderStyle}"/>
                    <StackPanel Margin="2">
                        <TextBlock Text="Última respuesta: " FontWeight="Bold" Foreground="#CCCCCC"/>
                        <!--Binding del comando(dentro del text)-->
                        <TextBlock Text="" Foreground="#4CD964" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!--Gráficas-->
            <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Gráfica circular: tiempo ojos abiertos / cerrados -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="TIEMPO DE OJOS" Style="{StaticResource CardHeaderStyle}"/>
                        <Grid Width="130" Height="130">
                            <Ellipse Fill="#2A2A2A"/>
                            <Path Data="{Binding SectorAbiertos}" Fill="#4CD964"/>
                            <Path Data="{Binding SectorCerrados}" Fill="#5AC8FA"/>
                            <Ellipse Width="70" Height="70" Fill="#1E1E1E"/>
                        </Grid>
                        <TextBlock Text="{Binding PorcentajeAbiertos}" Foreground="#4CD964" FontSize="12" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding PorcentajeCerrados}" Foreground="#5AC8FA" FontSize="12"/>
                    </StackPanel>

                    <!-- Gráfica de barras: parpadeos por minuto -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="PARPADEOS POR MINUTO" Style="{StaticResource CardHeaderStyle}"/>
                        <ItemsControl ItemsSource="{Binding ParpadeosPorMinuto}" Height="150">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="26" Margin="2,0" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding Cantidad}" HorizontalAlignment="Center" FontSize="11" Foreground="#FFFFFF"/>
                                        <Border Height="{Binding Altura}" Background="#FF9F0A" CornerRadius="3,3,0,0"/>
                                        <TextBlock Text="{Binding Minuto}" HorizontalAlignment="Center" FontSize="11" Foreground="#888888" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Minuto" Foreground="#888888" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!--Lista del historial en tiempo real-->
            <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Historial de eventos" Style="{StaticResource CardHeaderStyle}"/>

                    <!--En el itemSource debe de ir el binding del historial de comandos-->
                    <ListView Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#D0D0D0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <!--Binding de la hora-->
                                <GridViewColumn Header="Hora" Width="65"/>
                                <!--Binding de la origen-->
                                <GridViewColumn Header="Origen" Width="75"/>
                                <!--Binding de la Acción-->
                                <GridViewColumn Header="Acción" Width="130"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>